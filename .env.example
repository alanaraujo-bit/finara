# Template de variaveis do Finara. Copie para apps/web/.env.local e preencha.
# Os valores reais saem do Railway: railway variables --service Postgres

DATABASE_URL="postgresql://usuario:senha@host.proxy.rlwy.net:porta/railway"
REDIS_URL="redis://default:senha@host.proxy.rlwy.net:porta"

BETTER_AUTH_SECRET="gere-32-bytes-aleatorios-em-base64"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Open Finance (Pluggy) -------------------------------------------------
# Pegue no dashboard: https://dashboard.pluggy.ai
#
# ATENCAO: estas duas variaveis NAO tem o prefixo NEXT_PUBLIC_ de proposito.
# Qualquer variavel com esse prefixo e' embutida no bundle do browser, o que
# entregaria o segredo pra qualquer visitante. Elas so' podem ser lidas em
# codigo de servidor (src/lib/pluggy.ts).
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Segredo que compoe a URL do webhook: /api/webhooks/pluggy/<SEGREDO>
# O Pluggy nao assina os webhooks, entao este valor e' o que impede qualquer
# um de disparar eventos falsos. Gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(crypto.randomUUID().replaceAll('-',''))"
PLUGGY_WEBHOOK_SECRET=""
