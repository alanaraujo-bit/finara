{
  "name": "finara",
  "version": "0.1.0",
  "private": true,
  "description": "Finara — sistema financeiro pessoal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @finara/web dev",
    "build": "pnpm --filter @finara/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "worker:dev": "pnpm --filter @finara/worker dev",
    "db:generate": "pnpm --filter @finara/db generate",
    "db:push": "pnpm --filter @finara/db push",
    "db:studio": "pnpm --filter @finara/db studio"
  }
}
